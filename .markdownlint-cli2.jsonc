// DOC-01 Markdown lint (`pnpm lint:md`). Only the maintained docs are
// listed; docs/tech-rewrite/ (untracked analysis material) is not linted.
// README.md is left out until DOC-03 rewrites it (MD040 / MD001 findings,
// dead link to angular/README.md).
{
  "config": {
    "default": true,
    // Prose is wrapped by hand; long tables and links are fine.
    "MD013": false,
    // Repeated sub-headings (e.g. "Examples") under different sections.
    "MD024": { "siblings_only": true },
  },
  "globs": ["docs/functional-spec.md", "deploy/README.md"],
  "ignores": ["**/node_modules/**", "docs/tech-rewrite/**"],
}
