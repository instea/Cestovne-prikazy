{
  "name": "leaves",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm --filter @leaves/shared run build && pnpm --filter @leaves/api run build && pnpm --filter @leaves/web run build",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --project shared --project api-unit --project web",
    "test:integration": "vitest run --project api-integration --passWithNoTests",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
