{
  "name": "@leaves/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "migrate:legacy": "pnpm --filter @leaves/shared run build && nest build && node dist/migration/migrate-legacy.js",
    "anonymize:legacy": "pnpm --filter @leaves/shared run build && nest build && node dist/migration/anonymize-legacy.js",
    "record:parity-fixtures": "pnpm --filter @leaves/shared run build && nest build && node dist/migration/record-parity-fixtures.js",
    "cli": "pnpm --filter @leaves/shared run build && nest build && node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@leaves/shared": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^2.0.1",
    "date-fns": "4.4.0",
    "express": "5.3.0",
    "google-auth-library": "^11.3.3",
    "jose": "^6.2.15",
    "mongoose": "^8.24.8",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@testcontainers/mongodb": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "msw": "^3.0.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "yaml": "^2.9.1"
  }
}
