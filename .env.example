# Local development config for apps/api, loaded from the repo root by
# `pnpm dev` (never in production). Copy to .env and fill in what you need.
# Never commit .env. Production values come from k8s Secrets (NFR-05).
#
# Secrets (NFR-05 target 4) have EMPTY values here on purpose; set your own
# local values in .env. Non-secret settings below are local defaults.

NODE_ENV=development
PORT=4100
BASE_URL=http://localhost:5173
# Secret in production (contains credentials). Empty = the local default
# mongodb://localhost:27017/cestaky (docker compose MongoDB).
MONGO_URL=

# Google sign-in (AUTH-01)
HOSTED_DOMAIN=instea.co
GOOGLE_CLIENT_ID=<your Google OAuth client id>
AUTH_GOOGLE_VERIFIER=google

# Session (AUTH-02). Required, at least 32 bytes; the API refuses to start
# without it. Generate one: openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Mail via local Mailpit (http://localhost:8025). Mailpit accepts any
# user/password: set SMTP_PASSWORD to any value (e.g. mailpit) to send mail
# locally; empty disables sending (one warn log line per skipped email).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=mailpit
SMTP_PASSWORD=
MAIL_SENDER=leaves@localhost
APPROVAL_MAIL_RECEIVER=approver@localhost

DEFAULT_TIMEZONE=Europe/Bratislava

# Attendance M2M API: empty M2M credentials = every attendance call gets 401;
# pick any local values to call it. SSO and Toggl point at a local mock.
M2M_USERNAME=
M2M_PASSWORD=
SSO_URI=http://localhost:4010/api/meta/all
SSO_USERNAME=
SSO_PASSWORD=
TOGGL_REPORTS_BASE_URL=http://localhost:4010/toggl/reports/api/v3

# Migration only (MIG-01): the restored legacy database cestaky_legacy.
LEGACY_MONGO_URL=

LOG_LEVEL=debug
APP_VERSION=0.0.0-dev
