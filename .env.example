# Local development config for apps/api, loaded from the repo root by
# `pnpm dev` (never in production). Copy to .env and replace the
# placeholders. Never commit .env. Production values come from k8s secrets.

NODE_ENV=development
PORT=4100
BASE_URL=http://localhost:5173
MONGO_URL=mongodb://localhost:27017/cestaky?directConnection=true

# Google sign-in (AUTH-01)
HOSTED_DOMAIN=instea.co
GOOGLE_CLIENT_ID=<your Google OAuth client id>
AUTH_GOOGLE_VERIFIER=google

# Session (AUTH-02)
JWT_ACCESS_SECRET=dev-only-change-me-32-bytes-minimum
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Mail via local Mailpit (http://localhost:8025). Mailpit accepts any
# user/password; leave SMTP_USER or SMTP_PASSWORD empty to disable sending
# (one warn log line per skipped email instead).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=mailpit
SMTP_PASSWORD=mailpit
MAIL_SENDER=leaves@localhost
APPROVAL_MAIL_RECEIVER=approver@localhost

DEFAULT_TIMEZONE=Europe/Bratislava

# Attendance M2M API; SSO and Toggl point at the local mock server
M2M_USERNAME=m2m
M2M_PASSWORD=m2m-dev-only
SSO_URI=http://localhost:4010/api/meta/all
SSO_USERNAME=sso
SSO_PASSWORD=sso-dev-only
TOGGL_REPORTS_BASE_URL=http://localhost:4010/toggl/reports/api/v3

LOG_LEVEL=debug
APP_VERSION=0.0.0-dev
